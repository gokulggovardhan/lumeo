# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.*.local
!.env.example
.lumeo-ui-backup/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code local-only config (skills/ and launch.json are shared, committed)
.claude/settings.local.json
__pycache__/
*.pyc

# graphify: regenerable extraction cache and dated snapshots -- only the
# current graph.json/GRAPH_REPORT.md/graph.html/manifest.json are committed
graphify-out/cache/
graphify-out/20*/

# superpowers workflow scratch (task briefs, review packages, progress ledger)
.superpowers/
