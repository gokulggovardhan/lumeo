NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional override for the immutable browser Office runtime.
# Production defaults to Lumeo's versioned same-origin /office-runtime/... route.
# Set this only when intentionally moving the runtime to another verified
# immutable origin such as a dedicated Cloudflare R2 custom domain.
NEXT_PUBLIC_LUMEO_OFFICE_ASSET_BASE_URL=

# Supabase publishable keys may be used in browser code.
# Secret or service-role keys must never use NEXT_PUBLIC.
# Put real values in .env.local for development and configure production values in Cloudflare Workers Builds / Worker environment settings.
